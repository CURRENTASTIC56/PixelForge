<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android=\"http://schemas.android.com/apk/res/android\"
    android:layout_width=\"match_parent\"
    android:layout_height=\"match_parent\"
    android:orientation=\"vertical\"
    android:padding=\"20dp\"
    android:background=\"#121212\">

    <!-- Server Status -->  
    <TextView
        android:id=\"@+id/tvStatus\"
        android:layout_width=\"wrap_content\"
        android:layout_height=\"wrap_content\"
        android:text=\"Server Status: Not Running\"
        android:textColor=\"#FFFFFF\"
        android:textSize=\"18sp\"/>

    <!-- Server Type Spinner -->  
    <Spinner
        android:id=\"@+id/spinnerServerType\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:entries=\"@array/server_types\"/>

    <!-- RAM Input -->  
    <EditText
        android:id=\"@+id/etRam\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:hint=\"Enter RAM (MB)\"
        android:inputType=\"number\"
        android:textColor=\"#FFFFFF\"
        android:background=\"#333333\"/>

    <!-- Buttons -->  
    <Button
        android:id=\"@+id/btnStartServer\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:text=\"Start Server\"
        android:backgroundTint=\"#4CAF50\"/>
    <Button
        android:id=\"@+id/btnStopServer\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:text=\"Stop Server\"
        android:backgroundTint=\"#F44336\"/>
    <Button
        android:id=\"@+id/btnPortForward\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:text=\"Enable Port Forwarding\"
        android:backgroundTint=\"#FFC107\"/>
    <Button
        android:id=\"@+id/btnViewLogs\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:text=\"View Console Logs\"
        android:backgroundTint=\"#03A9F4\"/>
    <Button
        android:id=\"@+id/btnBackup\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:text=\"Backup World Data\"
        android:backgroundTint=\"#9C27B0\"/>
    <Button
        android:id=\"@+id/btnManageFiles\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:text=\"Manage Server Files\"
        android:backgroundTint=\"#FF5722\"/>
    <Button
        android:id=\"@+id/btnManagePlayers\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:text=\"Manage Players\"
        android:backgroundTint=\"#E91E63\"/>
    <Button
        android:id=\"@+id/btnConfigureServer\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:text=\"Configure Server\"
        android:backgroundTint=\"#009688\"/>
    <Button
        android:id=\"@+id/btnManagePlugins\"
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:text=\"Manage Plugins\"
        android:backgroundTint=\"#3F51B5\"/>
</LinearLayout>
